{
  "id": "IM-001",
  "name": "Interrogative Matrix",
  "status": "EXPERIMENTAL",
  "purpose": "Addressable structures for identifying and expressing missing information. Access is provided through a custom Tsadi index; the matrix itself is not an instruction to ask.",
  "dimensions": {
    "identity": {
      "forms": [
        "who",
        "what"
      ],
      "target": "identity or nature"
    },
    "selection": {
      "forms": [
        "which"
      ],
      "target": "selection from a bounded set"
    },
    "association": {
      "forms": [
        "whose"
      ],
      "target": "possession or association"
    },
    "object_person": {
      "forms": [
        "whom"
      ],
      "target": "person as object or receiver"
    },
    "time": {
      "forms": [
        "when"
      ],
      "target": "time"
    },
    "location": {
      "forms": [
        "where"
      ],
      "target": "place or position"
    },
    "cause_reason_purpose": {
      "forms": [
        "why"
      ],
      "target": "cause, reason, or purpose"
    },
    "manner_method_mechanism": {
      "forms": [
        "how"
      ],
      "target": "manner, method, process, degree, or mechanism"
    },
    "quantity_degree": {
      "forms": [
        "how many",
        "how much",
        "how far"
      ],
      "target": "quantity or degree"
    },
    "property_state": {
      "forms": [
        "what kind",
        "how"
      ],
      "target": "property or state"
    },
    "relation": {
      "forms": [
        "how does X relate to Y",
        "what does X do to Y"
      ],
      "target": "relation"
    },
    "polar_uncertainty": {
      "forms": [
        "is",
        "does",
        "can"
      ],
      "target": "truth or polarity"
    },
    "alternatives": {
      "forms": [
        "X or Y"
      ],
      "target": "choice among alternatives"
    },
    "confirmation": {
      "forms": [
        "is X Y"
      ],
      "target": "confirmation"
    },
    "clarification": {
      "forms": [
        "what do you mean by X"
      ],
      "target": "clarification"
    }
  },
  "process": [
    "identify known state",
    "locate missing variable",
    "classify missing information",
    "select interrogative operator",
    "formulate question",
    "identify expected answer type"
  ],
  "provenance": "Research scaffold for supervised Recess observation; not promoted to VGM truth."
}
