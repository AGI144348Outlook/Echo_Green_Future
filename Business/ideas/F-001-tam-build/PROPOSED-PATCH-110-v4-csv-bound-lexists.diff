 from pathlib import Path
 
 MAX_RECORD_BYTES = 1_048_576  # Proposed bounded regular-file editorial record, not a dataset limit.
+MAX_CSV_BYTES = 1_048_576  # Proposed (§110): Dataset A is 584 bytes; same descriptor-checked bounded read.
+
+
+def read_regular_bounded(path, limit, what):
+    flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
+    fd = os.open(path, flags)
+    try:
+        if not stat.S_ISREG(os.fstat(fd).st_mode):
+            raise ValueError(what + " is not a regular file")
+        with os.fdopen(fd, "rb") as stream:
+            fd = -1
+            data = stream.read(limit + 1)
+    finally:
+        if fd >= 0:
+            os.close(fd)
+    if len(data) > limit:
+        raise ValueError(what + " exceeds 1 MiB limit")
+    return data
 
