+def check_local_paths(out, note):
+    """§69: with --terms, a file that carries the builder's local path must not be listed."""
+    files = sorted(out.glob("*.pdf")) + sorted(out.glob("*.epub"))
+    for f in files:
+        if f.suffix == ".epub":
+            with zipfile.ZipFile(f) as z:
+                n = sum(z.read(i).count(b"file://") for i in z.namelist())
+        else:
+            n = leaks(f.read_bytes())
+        note(n == 0, f"{f.name}: {n} file:// URI(s) (local build path; run PROPOSED-pdf_fix.py)" if n
+             else f"{f.name}: no file:// URIs")
