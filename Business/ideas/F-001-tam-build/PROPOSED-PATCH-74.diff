+def check_epub_identity(out, note):
+    """§74: with --terms, a delivered EPUB must be the one build.py wrote and epub_check.py passed."""
+    import hashlib
+    rp, bp = out / "epub-report.json", out / "build-report.json"
+    rep = json.loads(rp.read_text(encoding="utf-8")) if rp.exists() else {}
+    built = json.loads(bp.read_text(encoding="utf-8")).get("epub") if bp.exists() else None
+    built_bytes = built.get("bytes") if isinstance(built, dict) else None
+    failed = [r for r in rep.get("results", []) if r.get("level") == "FAIL"]
+    for f in sorted(out.glob("*.epub")):
+        h = hashlib.sha256(f.read_bytes()).hexdigest()
+        if h != rep.get("sha256"):
+            note(False, f"{f.name}: sha256 {h[:12]} is not the EPUB in epub-report.json")
+        elif failed or not rep.get("results"):
+            note(False, f"{f.name}: epub-report.json has {len(failed)} FAIL (or no results)")
+        elif rep.get("bytes") != built_bytes:
+            note(False, f"{f.name}: {rep.get('bytes')} bytes, build-report.json says {built_bytes}")
+        else:
+            note(True, f"{f.name}: sha256 {h[:12]} is the checked build EPUB ({built_bytes} bytes)")
+
