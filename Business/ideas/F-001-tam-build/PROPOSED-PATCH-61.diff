+    m = re.search(r"within\s+(\d+)\s+days", low)
+    note(m is not None and int(m.group(1)) == days,
+         f"refund window {m.group(1) if m else 'missing'} days vs agreed {days}")
+
+
+def main(listing, out, terms=None):
