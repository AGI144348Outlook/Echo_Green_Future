+def check_terms(low, terms, note):
+    """§61: the listing's price and refund lines must match the agreed terms."""
+    price, days = float(terms["price"]), int(terms["refund_days"])
+    line = next((l for l in low.splitlines() if "price:" in l), None)
+    amounts = [float(a) for a in re.findall(r"\$\s*(\d+(?:\.\d{1,2})?)", line or "")]
